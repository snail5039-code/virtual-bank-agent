<mxfile host="app.diagrams.net">
  <diagram name="공통 노드 (19개)" id="d1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="com" value="공통 노드&lt;br&gt;(agent 아님)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="465" y="45" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="대상 찾기&lt;br&gt;승인 대기 판정    common_pending_check&lt;br&gt;맥락 확인         common_check_context&lt;br&gt;사용자 확인       common_confirm_target&lt;br&gt;대상 해소         common_resolve_target" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="정보 채우기&lt;br&gt;인증              common_authenticate&lt;br&gt;부족 정보 질문    common_ask_missing_information&lt;br&gt;처리안 제시       common_propose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="승인&lt;br&gt;승인              common_approve&lt;br&gt;응답 해석         common_interpret_response&lt;br&gt;승인 전 수정      common_revise&lt;br&gt;실행 직전 재검증  common_revalidate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="330" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="마무리&lt;br&gt;저장              common_save&lt;br&gt;결과 안내         common_report&lt;br&gt;처리 기록         common_log_request" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="265" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="실패 · 예외&lt;br&gt;불가 안내         common_reject&lt;br&gt;오류 / 복구       common_error&lt;br&gt;도메인 반송       common_reroute" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="265" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="이어가기&lt;br&gt;후속 결과 조회    common_query_history&lt;br&gt;후속 업무 이어가기  common_next_task" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="265" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pat" value="적용할 패턴&lt;br&gt;&lt;br&gt;CommonWorkflow&lt;br&gt;&lt;br&gt;HITL&lt;br&gt;  interrupt / resume&lt;br&gt;&lt;br&gt;checkpoint / recovery / retry&lt;br&gt;&lt;br&gt;* 공통은 supervisor의&lt;br&gt;  라우팅 대상이 아니다&lt;br&gt;  모든 흐름 중간에 끼어든다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="140" width="260" height="215" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="역할 구분  (헷갈리기 쉬운 3쌍)&lt;br&gt;&lt;br&gt;맥락 확인   : &quot;그 카드&quot;, &quot;아까 그 계좌&quot;가 무엇인지 이전 대화에서 찾는다&lt;br&gt;사용자 확인 : 확신할 수 없거나 후보가 여러 개일 때 목록을 주고 고르게 한다&lt;br&gt;대상 해소   : 소유자로 거른 뒤 이름을 맞춰 ID로 바꾼다&lt;br&gt;              후보 0개 -&gt; 불가 안내 / 1개 -&gt; 확정 / 2개 이상 -&gt; 사용자 확인&lt;br&gt;&lt;br&gt;저장       : 파일에 쓴다. 실패할 수 있다&lt;br&gt;결과 안내  : 저장이 성공했을 때만 완료를 말한다&lt;br&gt;  * 두 개를 한 함수에 두면 저장 실패인데 완료를 출력하게 된다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="660" height="155" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="인증&lt;br&gt;&lt;br&gt;한 번 인증하면 그 세션 동안 유효하다. 업무마다 다시 받지 않는다&lt;br&gt;  세션 = thread_id 하나 = 프로그램을 켜고 끌 때까지&lt;br&gt;인증은 처리안 제시 &quot;전&quot;에 받는다&lt;br&gt;  승인 직후에 두면 인증이 틀렸을 때 처리안을 다시 만들어야 한다&lt;br&gt;수단 : 계좌 비밀번호 / PIN / 휴대전화번호 / 주민번호 뒷자리 중 택일&lt;br&gt;재시작하면 인증은 풀린다. 복구 시점에 다시 받는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="390" width="650" height="155" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="승인 규칙&lt;br&gt;&lt;br&gt;승인 노드에는 interrupt만 둔다. 다른 일을 넣지 않는다&lt;br&gt;  재개하면 그 노드를 처음부터 다시 실행하기 때문이다&lt;br&gt;자연어 응답을 승인 / 거절 / 취소 / 수정으로 매핑한다&lt;br&gt;  확신할 수 없으면 되묻는다&lt;br&gt;수정 시 바뀐 부분만 보여주지 않고 전체 내용을 다시 보여준다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="checkpoint&lt;br&gt;&lt;br&gt;그래프를 compile할 때 checkpointer를 하나 붙인다&lt;br&gt;  노드마다 따로 두는 것이 아니다. 모든 노드 경계에서 자동 저장된다&lt;br&gt;실행 시 thread_id를 넘긴다. 대화 세션 하나 = thread_id 하나&lt;br&gt;subgraph를 노드로 등록하면 부모의 checkpointer를 물려받는다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="575" width="650" height="130" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="retry&lt;br&gt;&lt;br&gt;저장 실패에만 붙인다&lt;br&gt;승인과 실행에는 붙이지 않는다&lt;br&gt;  승인을 자동 재시도하면 사용자에게 같은 질문을 반복하게 된다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4b6b6;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="735" width="660" height="115" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="recovery  (재시작 / 장애 복구)&lt;br&gt;&lt;br&gt;재시작 시 진행 중이던 업무를 확인하고 이어서 처리한다&lt;br&gt;이전 승인만으로 변경을 자동 실행하지 않는다. 복구 시점에 다시 확인받는다&lt;br&gt;  꺼져 있는 동안 잔액과 카드 상태가 달라졌을 수 있다" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4b6b6;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="735" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="com" target="g1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;" edge="1" parent="1" source="com" target="g2">
          <mxGeometry relative="1" as="geometry" />
