        <mxCell id="b6" value="일괄 결제 (여러 장)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="490" width="230" height="33" as="geometry" />
        </mxCell>
        <mxCell id="bn" value="결제 방식 4가지&lt;br&gt;전체 : 총액 전부&lt;br&gt;부분 : 지금 일부만 (회차 없음)&lt;br&gt;분할 : 앞으로 N개월 (회차 생김)&lt;br&gt;일괄 : 여러 장 한 번에&lt;br&gt;&lt;br&gt;저장 규칙&lt;br&gt;전체·부분·분할 : 한 번에 저장&lt;br&gt;  하나 실패하면 전부 롤백&lt;br&gt;일괄 : 건별 저장&lt;br&gt;  2건째 실패해도 1건째는 유지&lt;br&gt;* 나눠 이체와 정확히 반대" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f2f2f2;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="275" width="280" height="248" as="geometry" />
        </mxCell>
