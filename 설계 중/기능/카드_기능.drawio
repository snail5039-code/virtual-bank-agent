        <mxCell id="b4" value="부분 결제 (금액 지정)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="404" width="230" height="33" as="geometry" />
