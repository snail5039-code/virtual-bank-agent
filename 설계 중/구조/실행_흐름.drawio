        <mxCell id="b0" value="[분기 0]&lt;br&gt;승인 대기 중인 업무가 있는가?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cbad;fontColor=#000000;strokeColor=#333333;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
